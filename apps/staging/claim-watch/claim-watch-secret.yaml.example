# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: claim-watch-secret.yaml, encrypted with `sops -e -i` (steps: docs/claim-watch.md).
apiVersion: v1
kind: Secret
metadata:
  name: claim-watch
type: Opaque
stringData:
  WALLET_ADDRESS: "0x<wallet to watch>"
  TELEGRAM_BOT_TOKEN: "<token from @BotFather>"
  TELEGRAM_CHAT_ID: "<your chat id>"
