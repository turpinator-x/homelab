# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: ghcr-pull-secret.yaml, made with `kubectl create secret docker-registry` and encrypted with
# `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# Lets the cluster pull the private image. The token is a classic personal access token with read:packages only.
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-pull
type: kubernetes.io/dockerconfigjson
data:
  # base64 of {"auths":{"ghcr.io":{"username":"turpinator-x","password":"<token>","auth":"<base64 of user:token>"}}}
  .dockerconfigjson: REPLACE_ME_BASE64
