# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-staging-keys-secret.yaml, already generated for staging and encrypted with `sops -e -i`.
# The app's Fernet key for tax ids, staging's own (production's key never leaves production). Staging stores no
# real tax ids, so losing it only means re-generating it and resetting the demo data.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-staging-keys
type: Opaque
stringData:
  BLOCKONE_WEB_TAX_ID_KEYS: REPLACE_ME_FERNET_KEY
