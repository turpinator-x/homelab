# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-explorer-keys-secret.yaml, encrypted with `sops -e -i`. STAGING-ONLY keys (never production's
# or the laptop's .env), so each can be revoked alone. Only the worker reads them (base worker.yaml, optional: a
# missing key shows as "couldn't check <chain>: no API key set up"). ALCHEMY_API_KEY alone covers wallet chain
# detection on Ethereum, Base, BNB, Optimism, Arbitrum, Polygon and Avalanche.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-explorer-keys
  namespace: blockone-staging
type: Opaque
stringData:
  ALCHEMY_API_KEY: REPLACE_ME
  ETHERSCAN_API_KEY: REPLACE_ME # Etherscan V2: backup, and internal transfers Alchemy doesn't return
