# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-app-secret.yaml, made by the owner and encrypted with `sops -e -i`. Steps:
# docs/blockone-crypto-tax-staging.md. The tax id key is in blockone-staging-keys, not here.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-app
type: Opaque
stringData:
  # Cloudflare Zero Trust team name ("<team>" or "<team>.cloudflareaccess.com"): the same team as production
  BLOCKONE_WEB_CF_TEAM_DOMAIN: REPLACE_ME_TEAM
  # The STAGING Access application's Application Audience (AUD) tag (64 hex characters), not production's
  BLOCKONE_WEB_CF_AUD: REPLACE_ME_STAGING_AUD_TAG
  # Who may sign in to staging (a second check after the staging Access policy): the owner and the invited client
  # testers, comma-separated. Separate from production's list.
  BLOCKONE_WEB_ALLOWED_EMAILS: owner@example.com,client-tester@example.com
  # The Client ID of the staging smoke-test service token (32 hex characters + ".access"). The app accepts service
  # tokens only with BLOCKONE_WEB_SITE_MODE=staging and refuses this setting anywhere else.
  BLOCKONE_WEB_SERVICE_TOKEN_IDS: REPLACE_ME.access
