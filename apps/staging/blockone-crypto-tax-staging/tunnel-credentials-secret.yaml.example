# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: tunnel-credentials-secret.yaml, made from the tunnel's credentials file and encrypted with
# `sops -e -i`. Steps: docs/blockone-crypto-tax-staging.md
apiVersion: v1
kind: Secret
metadata:
  name: tunnel-credentials
type: Opaque
stringData:
  # The whole of ~/.cloudflared/<tunnel-id>.json from `cloudflared tunnel create blockone-staging`
  credentials.json: '{"AccountTag":"REPLACE_ME","TunnelSecret":"REPLACE_ME","TunnelID":"REPLACE_ME"}'
