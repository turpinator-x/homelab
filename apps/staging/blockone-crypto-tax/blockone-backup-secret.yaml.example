# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-backup-secret.yaml, encrypted with `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# ("Backups and restore", owner steps).
# The nightly upload's settings: an R2 token with Object Read & Write on the backup bucket only, and the crypt
# passwords run through `rclone obscure` (rclone expects them obscured; obscuring is not encryption, which is
# why this file is SOPS-encrypted). The plain passwords live in the password manager: without them no backup
# can be decrypted.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-backup
type: Opaque
stringData:
  R2_ENDPOINT: https://REPLACE_ME.r2.cloudflarestorage.com # https://<account id>.r2.cloudflarestorage.com
  R2_BUCKET: REPLACE_ME # e.g. blockone-backups
  R2_ACCESS_KEY_ID: REPLACE_ME # the read-and-write token's Access Key ID
  R2_SECRET_ACCESS_KEY: REPLACE_ME # its Secret Access Key
  RCLONE_CRYPT_PASSWORD: REPLACE_ME # rclone obscure of the crypt password
  RCLONE_CRYPT_PASSWORD2: REPLACE_ME # rclone obscure of the salt password
