# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-explorer-keys-secret.yaml, encrypted with `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# Only the worker reads these; it passes them to the engine's child processes. Each is optional: leave a line out
# and the engine skips (or reports as unchecked) what needs it. Use keys made for this deployment, not the
# laptop's .env keys, so either can be revoked alone.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-explorer-keys
type: Opaque
stringData:
  ETHERSCAN_API_KEY: REPLACE_ME # Etherscan V2: Ethereum L2s, Polygon, Arbitrum
  ALCHEMY_API_KEY: REPLACE_ME # Base, BNB Smart Chain, Optimism history
  HELIUS_API_KEY: REPLACE_ME # Solana
  BLOCKFROST_PROJECT_ID: REPLACE_ME # Cardano
  CRYPTOCOMPARE_API_KEY: REPLACE_ME # historical prices
