# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-app-secret.yaml, encrypted with `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# Read by the API and the worker (settings in the app repo: src/nftcb/web/settings.py).
apiVersion: v1
kind: Secret
metadata:
  name: blockone-app
type: Opaque
stringData:
  # Fernet key(s) that encrypt taxpayer SSNs/EINs in the database. Comma-separated, newest first (rotation).
  # Losing every key makes the stored tax ids unreadable: keep a copy in the password manager.
  BLOCKONE_WEB_TAX_ID_KEYS: REPLACE_ME_FERNET_KEY
  # Cloudflare Zero Trust team name ("<team>" or "<team>.cloudflareaccess.com")
  BLOCKONE_WEB_CF_TEAM_DOMAIN: REPLACE_ME_TEAM
  # The Access application's Application Audience (AUD) tag: 64 hex characters
  BLOCKONE_WEB_CF_AUD: REPLACE_ME_AUD_TAG
  # Who may sign in (a second check after Access's own policy), comma-separated
  BLOCKONE_WEB_ALLOWED_EMAILS: first@example.com,second@example.com
