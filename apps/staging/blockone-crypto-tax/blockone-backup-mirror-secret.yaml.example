# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-backup-mirror-secret.yaml, encrypted with `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# ("Backups and restore", owner steps).
# The mirror's (and a restore's) settings: a second R2 token with Object Read only, so neither can change the
# bucket, and the same obscured crypt passwords as blockone-backup.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-backup-mirror
type: Opaque
stringData:
  R2_ENDPOINT: https://REPLACE_ME.r2.cloudflarestorage.com
  R2_BUCKET: REPLACE_ME
  R2_ACCESS_KEY_ID: REPLACE_ME # the read-only token's Access Key ID
  R2_SECRET_ACCESS_KEY: REPLACE_ME
  RCLONE_CRYPT_PASSWORD: REPLACE_ME # the same obscured values as in blockone-backup
  RCLONE_CRYPT_PASSWORD2: REPLACE_ME
