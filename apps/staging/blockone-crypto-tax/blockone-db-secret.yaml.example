# TEMPLATE, placeholders only. Not applied by Flux (not listed in kustomization.yaml, and .example isn't .yaml).
# Real file: blockone-db-secret.yaml, encrypted with `sops -e -i`. Steps: docs/blockone-crypto-tax.md
# PostgreSQL's password. The API and worker build their database URL from it, so use hex characters only
# (openssl rand -hex 32): no character needs URL-escaping.
apiVersion: v1
kind: Secret
metadata:
  name: blockone-db
type: Opaque
stringData:
  password: REPLACE_ME # 64 hex characters
