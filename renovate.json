{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": ["clusters/staging/flux-system/**"],
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "timezone": "America/Los_Angeles",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Low risk: patch and digest updates merge on their own once CI passes",
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "schedule": ["at any time"]
    },
    {
      "description": "Low risk: minor updates of GitHub Actions",
      "matchUpdateTypes": ["minor"],
      "matchManagers": ["github-actions"],
      "automerge": true,
      "schedule": ["at any time"]
    },
    {
      "description": "Low risk: minor updates of Renovate's own image",
      "matchUpdateTypes": ["minor"],
      "matchDepNames": ["renovate/renovate"],
      "automerge": true,
      "schedule": ["at any time"]
    },
    {
      "description": "My own dashboard image: I release it, so deploy patch and minor versions straight away",
      "matchDepNames": ["ghcr.io/turpinator-x/homelab-dashboard"],
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "schedule": ["at any time"]
    },
    {
      "description": "Majors always wait for the weekly review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
